# Loaded by playwright.config.ts (copy to .env.e2e.local — gitignored via *.local)
E2E_BASE_URL=http://localhost:8080
E2E_API_URL=http://127.0.0.1:10000

# Shared password for all seeded @example.com personas (npm run seed:e2e)
E2E_USER_PASSWORD=

# --- Billing (real sandbox RC/Stripe accounts — NOT seeded) ---
E2E_CHECKOUT_USER_EMAIL=hello.worlda1220@gmail.com
E2E_PRO_USER_EMAIL=iamrohanilyas863@gmail.com
# Optional: verified free user with no RC sub for webhook revoke (defaults to E2E_WEBHOOK_FREE_EMAIL)
# E2E_WEBHOOK_USER_EMAIL=

# --- Seeded personas (defaults from npm run seed:e2e; override if needed) ---
E2E_ADMIN_EMAIL=e2e-admin@example.com
E2E_CHECKOUT_SEED_EMAIL=e2e-checkout@example.com
E2E_PRO_SEED_EMAIL=e2e-pro@example.com
E2E_WEBHOOK_FREE_EMAIL=e2e-webhook-free@example.com
E2E_STANDARD_USER_EMAIL=e2e-standard@example.com
E2E_SOCIAL_A_EMAIL=e2e-social-a@example.com
E2E_SOCIAL_B_EMAIL=e2e-social-b@example.com
E2E_PRIVATE_USER_EMAIL=e2e-private@example.com
E2E_SACRIFICIAL_EMAIL=e2e-sacrificial@example.com
E2E_SUSPENDED_EMAIL=e2e-suspended@example.com
E2E_UNVERIFIED_EMAIL=e2e-unverified@example.com
E2E_CHALLENGE_USER_EMAIL=e2e-challenge@example.com

# Seeded active challenge id (Road Atlanta GT3)
E2E_CHALLENGE_ID=e2e-challenge-road-atlanta-gt3

# Known verification code for E2E_UNVERIFIED_EMAIL after seed
E2E_UNVERIFIED_KNOWN_CODE=12345678

# Optional: pulled from ../apex/.env if unset
REVENUECAT_WEBHOOK_SECRET=

# If you start the apex backend yourself (Playwright reuseExistingServer), add to apex/.env:
# DISABLE_MANUAL_UPLOAD_RATE_LIMIT=1
ADMIN_SECRET=
